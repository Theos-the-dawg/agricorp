    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver", 
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1",  // Disables the creation of .pyc files
                "DJANGO_SETTINGS_MODULE": "agricorp.settings"  // Optional: Set your settings module
            },
            "justMyCode": true
        }
